---
import { site, footerGruplari, sosyal, instagramUrl } from '@/data/site';
import Logo from './Logo.astro';

const yil = new Date().getFullYear();
const anaHesaplar = [
  { etiket: 'Gaziantep', hesap: sosyal.gaziantepAna },
  { etiket: 'İzmir', hesap: sosyal.izmirAna },
];
---

<footer class="bg-ink text-on-ink">
  <div class="u-wrap py-16 md:py-20">
    <div class="flex flex-col gap-4 border-b border-line-on-ink pb-12">
      <Logo class="h-14 w-14" />
      <p class="font-display text-baslik font-bold uppercase tracking-[-0.02em]">
        {site.ad}
      </p>
      <p class="font-display text-buyuk text-accent-on-dark">
        {site.slogan}
      </p>
    </div>

    <div class="grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-5">
      {
        footerGruplari.map((grup) => (
          <nav aria-label={grup.baslik}>
            <h2 class="u-eyebrow text-on-ink-muted">{grup.baslik}</h2>
            <ul class="mt-4 flex flex-col gap-1">
              {grup.baglantilar.map((b) => (
                <li>
                  <a
                    href={b.href}
                    class="flex min-h-9 items-center font-display text-[0.95rem] text-on-ink transition-colors hover:text-accent-on-dark"
                  >
                    {b.etiket}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="flex flex-col gap-6 border-t border-line-on-ink pt-10 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col gap-2">
        <a
          href={`mailto:${site.eposta}`}
          class="font-display text-buyuk font-semibold text-on-ink underline decoration-accent-on-dark decoration-2 underline-offset-4"
        >
          {site.eposta}
        </a>
        <p class="text-kucuk text-on-ink-muted">
          {site.kurulus}'den beri Gaziantep ve İzmir'de.
        </p>
      </div>

      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          anaHesaplar.map((h) => (
            <li>
              <a
                href={instagramUrl(h.hesap)}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-11 items-center gap-2 font-display text-[0.9rem] text-on-ink-muted transition-colors hover:text-on-ink"
              >
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
                <span>Instagram · {h.etiket}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-10 text-kucuk text-on-ink-muted">
      © {yil} {site.ad}. Tüm hakları saklıdır.
    </p>
  </div>
</footer>
