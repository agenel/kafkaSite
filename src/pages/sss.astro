---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SayfaBasligi from '@/components/SayfaBasligi.astro';
import Bolum from '@/components/Bolum.astro';
import Buton from '@/components/Buton.astro';
import { cta } from '@/data/site';

const sorular = await getCollection('sss');

const kategoriEtiketi: Record<string, string> = {
  genel: 'Genel',
  kayit: 'Kayıt ve tanışma',
  ucret: 'Ücret',
  'okul-oncesi': 'Okul Öncesi',
  cocuklar: 'Çocuklar',
  gencler: 'Gençler',
  yetiskinler: 'Yetişkinler',
  international: 'Kafka International',
  kostum: 'Kafka Kostüm',
};
const sira = Object.keys(kategoriEtiketi);
const gruplar = sira
  .map((k) => ({ kod: k, etiket: kategoriEtiketi[k]!, sorular: sorular.filter((s) => s.data.kategori === k) }))
  .filter((g) => g.sorular.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sorular.map((s) => ({
    '@type': 'Question',
    name: s.data.soru,
    acceptedAnswer: { '@type': 'Answer', text: s.data.cevap },
  })),
};
---

<BaseLayout
  title="Sık Sorulan Sorular | Kafka Sanat Akademisi"
  description="Programlar, kayıt, tanışma, ücretler, Kafka International ve Kafka Kostüm hakkında sık sorulan sorular."
  jsonLd={jsonLd}
>
  <SayfaBasligi
    ustBaslik={`28 · ${sorular.length} soru`}
    baslik="Sık Sorulan Sorular"
    girisMetni="Aradığınız cevabı bulamazsanız başvuru formunu doldurun; ekibimiz 1 iş günü içinde size ulaşsın."
  />

  <Bolum bosluk="genis">
    {
      gruplar.map((g) => (
        <section class="mb-14 last:mb-0" aria-labelledby={`sss-${g.kod}`}>
          <h2
            id={`sss-${g.kod}`}
            class="border-b-2 border-ink pb-4 font-display text-baslik font-bold uppercase tracking-[-0.02em] text-ink"
          >
            {g.etiket}
          </h2>
          <div class="mt-2">
            {g.sorular.map((s) => (
              <details class="group border-b border-line">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-buyuk font-semibold tracking-tight text-ink transition-colors hover:text-accent">
                  <span>{s.data.soru}</span>
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="mt-1 h-5 w-5 shrink-0 transition-transform duration-200 group-open:rotate-45"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </summary>
                <p class="u-measure-wide pb-6 text-govde leading-[1.7] text-body">
                  {s.data.cevap}
                </p>
              </details>
            ))}
          </div>
        </section>
      ))
    }
  </Bolum>

  <Bolum zemin="murekkep" bosluk="normal">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="u-measure font-display text-baslik font-bold leading-tight text-on-ink">
        Sorunuzun cevabı yoksa bize sorun.
      </p>
      <Buton href="/basvuru" etiket={cta.basvuru} boyut="buyuk" />
    </div>
  </Bolum>
</BaseLayout>
