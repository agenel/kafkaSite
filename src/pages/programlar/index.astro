---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SayfaBasligi from '@/components/SayfaBasligi.astro';
import Bolum from '@/components/Bolum.astro';
import ProgramKarti from '@/components/ProgramKarti.astro';
import Buton from '@/components/Buton.astro';
import { cta, yasCatilari } from '@/data/site';
import { catidakiProgramlar, durumlar, programYolu } from '@/lib/programlar';

const gruplar = await Promise.all(
  yasCatilari.map(async (c) => ({
    ...c,
    programlar: await catidakiProgramlar(c.kod),
  }))
);
const toplam = (await getCollection('programlar')).length;
---

<BaseLayout
  title="Programlar | Okul Öncesi, Çocuklar, Gençler, Yetişkinler | Kafka"
  description="Kafka Sanat Akademisi'nin okul öncesinden yetişkinlere uzanan tüm sanat ve üretim programları."
>
  <SayfaBasligi
    ustBaslik={`${toplam} program · dört yaş çatısı`}
    baslik="Programlar"
    acilisAlintisi="Her yaşta aynı şeyi yapmıyoruz."
    girisMetni="Kullanıcı önce kendisine uygun yaş ve yaşam evresine girer, ardından programları görür. Kulüp, atölye, kurs, laboratuvar ve topluluk gibi sözcükler ana çatı değil; programın formatını tanımlar."
  />

  {
    gruplar.map((g) => (
      <Bolum
        zemin={g.kod === 'cocuklar' || g.kod === 'yetiskinler' ? 'cukur' : 'kagit'}
        bosluk="normal"
        etiketleyen={`cati-${g.kod}`}
      >
        <div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-ink pb-5">
          <h2
            id={`cati-${g.kod}`}
            class="font-display text-baslik-lg font-bold uppercase tracking-[-0.025em] text-ink"
          >
            {g.etiket}
          </h2>
          <a
            href={g.href}
            class="inline-flex min-h-11 items-center font-display text-[0.92rem] font-semibold text-ink underline decoration-accent decoration-2 underline-offset-[6px] hover:text-accent"
          >
            {g.etiket} sayfasına git
          </a>
        </div>
        <ul class="mt-9 grid gap-x-12 gap-y-9 md:grid-cols-2">
          {g.programlar.map((p, i) => (
            <li>
              <ProgramKarti
                href={programYolu(p.id)}
                ad={p.data.ad}
                kisaTanim={p.data.kisaTanim}
                amiral={p.data.amiral}
                durumlar={durumlar(p)}
                numara={i + 1}
              />
            </li>
          ))}
        </ul>
      </Bolum>
    ))
  }

  <Bolum zemin="murekkep" bosluk="normal">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="u-measure font-display text-baslik font-bold leading-tight tracking-[-0.02em] text-on-ink">
        Hangi programın doğru olduğundan emin olmak zorunda değilsiniz.
      </p>
      <Buton href="/basvuru" etiket={cta.basvuru} boyut="buyuk" />
    </div>
  </Bolum>
</BaseLayout>
