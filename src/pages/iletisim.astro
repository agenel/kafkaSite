---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SayfaBasligi from '@/components/SayfaBasligi.astro';
import Bolum from '@/components/Bolum.astro';
import Buton from '@/components/Buton.astro';
import {
  site, cta, sosyal, instagramUrl, waLink, telLink, yapiSorumlusu,
} from '@/data/site';

const subeler = (await getCollection('subeler')).sort((a, b) => a.data.sira - b.data.sira);

const tumHesaplar = [
  { etiket: 'Gaziantep ana', hesap: sosyal.gaziantepAna },
  { etiket: 'İzmir ana', hesap: sosyal.izmirAna },
  { etiket: 'Gaziantep Çocuk Tiyatrosu', hesap: sosyal.gaziantepCocukTiyatrosu },
  { etiket: 'Gaziantep Gençlik Tiyatrosu', hesap: sosyal.gaziantepGenclikTiyatrosu },
  { etiket: 'Güzelbahçe Çocuk Tiyatrosu', hesap: sosyal.guzelbahceCocukTiyatrosu },
  { etiket: 'Kitap Kulübü', hesap: sosyal.kitapKulubu },
  { etiket: 'Sinema Kulübü', hesap: sosyal.sinemaKulubu },
  { etiket: 'Kafka Akademi Tiyatrosu', hesap: sosyal.kat },
  { etiket: 'Güzelbahçe atölye', hesap: sosyal.guzelbahceAtolye },
  { etiket: 'Kafka Kostüm', hesap: sosyal.kostum },
];
---

<BaseLayout
  title="İletişim | Kafka Sanat Akademisi"
  description="Gaziantep ve İzmir şube iletişim bilgileri, adresler, WhatsApp hatları ve sosyal medya hesapları."
>
  <SayfaBasligi
    ustBaslik="27 · Kafka"
    baslik="İletişim"
    girisMetni="Şube iletişimleri, adresler ve yapı sorumluları. İlk temas için WhatsApp en hızlı kanaldır."
  />

  <Bolum bosluk="genis" etiketleyen="subeler-iletisim">
    <h2 id="subeler-iletisim" class="u-eyebrow">Şubeler</h2>
    <ul class="mt-8 grid gap-px bg-line-strong lg:grid-cols-2">
      {
        subeler.map((s) => (
          <li class="flex flex-col gap-5 bg-paper p-7 md:p-9">
            <h3 class="font-display text-baslik font-bold tracking-[-0.025em] text-ink">
              {s.data.ad}
            </h3>
            <dl class="flex flex-col">
              <div class="grid gap-0.5 border-t border-line py-4 sm:grid-cols-[8rem_1fr] sm:gap-4">
                <dt class="u-eyebrow pt-1">Telefon</dt>
                <dd>
                  <a href={telLink(s.data.telefon)} class="inline-flex min-h-11 items-center font-display font-semibold text-ink hover:text-accent">
                    {s.data.telefon}
                  </a>
                </dd>
              </div>
              <div class="grid gap-0.5 border-y border-line py-4 sm:grid-cols-[8rem_1fr] sm:gap-4">
                <dt class="u-eyebrow pt-1">Adres</dt>
                <dd class="leading-relaxed text-body">
                  <span class="block">{s.data.adres}</span>
                  {s.data.haritaUrl && (
                    <a
                      href={s.data.haritaUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-1 inline-flex min-h-11 w-fit items-center gap-1.5 font-display text-[0.9rem] font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
                    >
                      Haritada Aç
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
                    </a>
                  )}
                </dd>
              </div>
            </dl>
            <div class="mt-auto flex flex-wrap gap-3">
              <Buton href={waLink(s.data.telefon)} etiket={cta.whatsappSor} disBaglanti />
              <Buton href={`/${s.data.kod}`} etiket="Şube Sayfası" tur="ikincil" />
            </div>
          </li>
        ))
      }
    </ul>
  </Bolum>

  <Bolum zemin="cukur" bosluk="normal" etiketleyen="genel-iletisim">
    <h2 id="genel-iletisim" class="u-eyebrow">Genel iletişim</h2>
    <dl class="mt-7 grid gap-x-10 gap-y-7 sm:grid-cols-2">
      <div>
        <dt class="u-eyebrow">Genel e-posta</dt>
        <dd class="mt-2">
          <a href={`mailto:${site.eposta}`} class="inline-flex min-h-11 items-center font-display text-buyuk font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4">
            {site.eposta}
          </a>
        </dd>
      </div>
      <div>
        <dt class="u-eyebrow">Kafka International / Kafka Kostüm</dt>
        <dd class="mt-2 text-govde leading-relaxed text-body">
          {yapiSorumlusu.ad} ·
          <a href={telLink(yapiSorumlusu.telefon)} class="inline-flex min-h-11 items-center font-display font-semibold text-ink hover:text-accent">
            {yapiSorumlusu.telefon}
          </a>
        </dd>
      </div>
    </dl>
  </Bolum>

  <Bolum bosluk="genis" etiketleyen="sosyal-medya">
    <h2 id="sosyal-medya" class="font-display text-baslik-lg font-bold tracking-[-0.025em] text-ink">
      Sosyal medya
    </h2>
    <p class="u-measure-wide mt-4 text-govde leading-relaxed text-muted">
      Instagram öncelikli sosyal kanalımızdır. Şubeler ve yapılar kendi hesaplarından
      güncel çalışmalarını paylaşır.
    </p>
    <ul class="mt-9 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        tumHesaplar.map((h) => (
          <li class="bg-paper">
            <a
              href={instagramUrl(h.hesap)}
              target="_blank"
              rel="noopener noreferrer"
              class="flex min-h-20 flex-col justify-center gap-1 p-5 transition-colors hover:bg-paper-sunken"
            >
              <span class="u-eyebrow">{h.etiket}</span>
              <span class="font-display text-govde font-semibold text-ink">
                @{h.hesap}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Bolum>

  <Bolum zemin="murekkep" bosluk="normal">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="u-measure font-display text-baslik font-bold leading-tight text-on-ink">
        Önce başvurun. Sonra tanışalım.
      </p>
      <Buton href="/basvuru" etiket={cta.basvuru} boyut="buyuk" />
    </div>
  </Bolum>
</BaseLayout>
