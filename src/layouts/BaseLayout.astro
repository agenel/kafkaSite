---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { site } from '@/data/site';

interface Props {
  title: string;
  description: string;
  /** Sayfaya özel JSON-LD; Organization her sayfada zaten var. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogGorsel?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  jsonLd,
  ogGorsel = '/logo.png',
  noindex = false,
} = Astro.props;

const kanonik = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogUrl = new URL(ogGorsel, Astro.site ?? site.url).href;

const kurum = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: site.ad,
  slogan: site.slogan,
  foundingDate: String(site.kurulus),
  url: site.url,
  email: site.eposta,
  logo: new URL('/logo.png', Astro.site ?? site.url).href,
};

const semalar = [kurum, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={kanonik} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#0b0b0c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.ad} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {semalar.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader />
    <main id="icerik" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
